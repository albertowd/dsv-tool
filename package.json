{
  "dependencies": {
    "@fontsource/roboto": "^5",
    "@mdi/font": "^7",
    "@pinia/nuxt": "^1",
    "nuxt": "^4",
    "pinia": "^4",
    "vue": "^3",
    "vue-router": "^4",
    "vuetify": "^4"
  },
  "description": "A DSV (DeSmuME/DraStic) converter from/to RAW DS save files.",
  "devDependencies": {
    "@nuxt/eslint": "^1",
    "@nuxt/test-utils": "^4",
    "@types/node": "^26",
    "@vite-pwa/assets-generator": "^1",
    "@vite-pwa/nuxt": "^1",
    "@vitest/coverage-v8": "^4",
    "@vue/test-utils": "^2",
    "eslint": "^10",
    "happy-dom": "^20",
    "sass-embedded": "^1",
    "typescript": "^5",
    "vite-plugin-vuetify": "^2",
    "vitest": "^4",
    "vue-tsc": "^3"
  },
  "name": "dsv-tools",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "sonar": "./scripts/sonar.sh",
    "sonar:credentials": "./scripts/sonar-credentials.sh",
    "sonar:down": "docker compose down",
    "sonar:logs": "docker compose logs -f sonarqube",
    "sonar:reset": "docker compose down -v",
    "sonar:up": "docker compose up -d",
    "start": "nuxt preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "nuxt typecheck"
  },
  "type": "module",
  "version": "2.0.0"
}
